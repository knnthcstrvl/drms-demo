<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Model;

class Student extends Model
{
    use HasFactory;

    public $timestamps = false;

    protected $table = 'students';

    protected $primaryKey = 'id';

    protected $fillable = [
        'last_name',
        'first_name',
        'middle_name',
        'birth_date',
        'student_number',
        'program',
        'year_graduated',
        'date_time_created',
        'date_time_updated',
        'doc_path',
    ];

    protected $casts = [
        'date_time_created' => 'datetime',
        'date_time_updated' => 'datetime',
    ];

    /**
     * Check if student has a document
     */
    public function hasDocument()
    {
        return !empty($this->doc_path) && file_exists(storage_path("app/public/documents/{$this->doc_path}"));
    }

    /**
     * Get full document path
     */
    public function getDocumentPath()
    {
        return $this->doc_path ? storage_path("app/public/documents/{$this->doc_path}") : null;
    }
}